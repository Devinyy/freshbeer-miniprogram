.tabbar { display: flex; height: calc(56px + env(safe-area-inset-bottom)); padding-bottom: env(safe-area-inset-bottom); box-sizing: border-box; background: #fff; border-top: 1px solid #f0e8dc; box-shadow: 0 -2px 8px rgba(44, 24, 16, .04); }
.tabbar__item { flex: 1; min-width: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; color: #8b7d6b; }
.tabbar__item--active { color: #f5a623; }
.tabbar__cart-wrap { height: 25px; display: flex; align-items: center; justify-content: center; }
.tabbar__cart-wrap--raised { width: 42px; height: 42px; margin-top: -12px; border: 3px solid #fff; border-radius: 50%; background: #fff0d6; }
.tabbar__icon { width: 24px; height: 24px; }
.tabbar__label { margin-top: 2px; font-size: 10px; line-height: 14px; }
